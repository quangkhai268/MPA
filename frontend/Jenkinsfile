// Jenkins job: Script Path = frontend/Jenkinsfile, checkout TOÀN BỘ repo (không chỉ thư mục frontend)
// — các bước dưới đây tự dir('frontend') vào đúng chỗ.
// Yêu cầu hạ tầng Jenkins:
//   - Node/agent chạy stage "Docker Build"/"Docker Push" phải có sẵn Docker CLI + quyền truy cập
//     Docker daemon (docker.sock) — không dùng Docker-in-Docker, build ngay trên host Jenkins agent.
//   - Credential Jenkins kiểu "Username with password" (username = GitHub user, password = PAT có
//     quyền write:packages) đặt ID đúng bằng REGISTRY_CREDS bên dưới, dùng để push lên ghcr.io.
//     Đổi IMAGE_NAME/registry nếu dùng Docker Hub hoặc registry nội bộ khác.
// Ghi chú stage Test: dự án chưa có karma.conf.js riêng (dùng cấu hình Karma mặc định của
// Angular CLI) và chưa cài karma-junit-reporter — nên báo cáo JUnit ở bước "Install & Test" có
// thể rỗng (allowEmptyResults tránh làm fail build vì lý do này). Nếu ChromeHeadless không khởi
// động được trong container (lỗi sandbox), thêm file frontend/karma.conf.js với customLaunchers
// ChromeHeadlessNoSandbox (flags: ['--no-sandbox', '--disable-gpu']) rồi đổi --browsers tương ứng.

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME     = 'quangkhai268/mpa-frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Install & Test') {
            when { changeset "frontend/**" }
            agent {
                docker {
                    // node:20 (Debian, không phải alpine) để tải Chromium qua puppeteer chạy được —
                    // binary Chrome dựng sẵn không tương thích tốt với musl libc của alpine.
                    image 'node:20'
                    args '-u node'
                    reuseNode true
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npx puppeteer browsers install chrome'
                    sh '''
                        export CHROME_BIN=$(find "$HOME/.cache/puppeteer" -type f -name chrome | head -1)
                        npx ng test --no-watch --no-progress --browsers=ChromeHeadless
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'frontend/test-results/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Build') {
            when { changeset "frontend/**" }
            agent {
                docker {
                    image 'node:20'
                    args '-u node'
                    reuseNode true
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm run build -- --configuration production'
                }
            }
        }

        stage('Docker Build') {
            when { changeset "frontend/**" }
            steps {
                dir('frontend') {
                    sh "docker build -t ${IMAGE_NAME}:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Deploy') {
            when { changeset "frontend/**" }
            steps {
                sh """
                    cd /opt/project &&
                    sed -i 's/^FRONTEND_IMAGE_TAG=.*/FRONTEND_IMAGE_TAG=${env.IMAGE_TAG}/' .env &&
                    docker compose up -d frontend
                """
            }
        }

        stage('Smoke Test') {
            when { changeset "frontend/**" }
            steps {
                sleep 10
                sh 'curl -f https://mybcardportal.com/'
            }
        }

    }

    post {
        success {
            emailext (
                subject: "✅ Frontend deploy thành công: #${env.BUILD_NUMBER}",
                body: "<p><b>Image:</b> mycompany/frontend:${env.IMAGE_TAG}</p><p><a href=\"${env.BUILD_URL}\">Chi tiết</a></p>",
                mimeType: 'text/html',
                to: 'lekhai268@gmail.com'
            )
        }
        failure {
            emailext (
                subject: "❌ Frontend build/deploy thất bại: #${env.BUILD_NUMBER}",
                body: "<p><a href=\"${env.BUILD_URL}console\">Xem log lỗi</a> </p>",
                mimeType: 'text/html',
                to: 'lekhai268@gmail.com'
            )
        }
    }
}
